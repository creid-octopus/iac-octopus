# Copy to terraform.tfvars (gitignored) and fill in values
# Most defaults in variables.tf are fine — only override what you need

resource_group_name = "rg-argocd-demo"
location            = "centralus"
cluster_name        = "aks-argocd-demo"
node_size           = "Standard_B2s"
node_min_count      = 1
node_max_count      = 2
environment         = "demo"

# kubernetes_version = "1.30"  # Uncomment to pin; leave unset for latest default

# ArgoCD admin password — store the BCRYPT HASH here, not the plaintext password

# Generate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(10)).decode())"
# OR
# htpasswd -nbBC 10 "" yourpassword | tr -d ':\n'

argocd_admin_password_hash = "$2a$10$REPLACE_WITH_YOUR_HASH"
