variable "Project.AzureAccount" {
    type = "AzureAccount"

    value "tenants-azure-subscription" {}
}

variable "Project.Terraform.ArgoTarget" {
    value "-target=helm_release.argocd" {
        description = "Used to provide `-target` parameters to core resource creation"
    }
}

variable "Project.Terraform.CoreTarget" {
    value "-target=module.eks" {
        description = "Used to provide `-target` parameters to core resource creation. For AKS: -target=azurerm_kubernetes_cluster.main. For EKS: -target=module.eks"
    }
}

variable "Project.Terraform.CloudProvider" {
    value "eks" {
        description = "Cloud provider for the Terraform tier — aks or eks. Controls which backend/provider blocks are active."
    }
}

variable "Terraform.Environment.Name" {
    value "development,test" {
        environment = ["meta-nonproduction"]
    }

    value "production" {
        environment = ["meta-production"]
    }
}
