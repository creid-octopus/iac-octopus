name = "Terraform Destroy"
cancel_queued_tasks = true
cancel_running_tasks = true
default_guided_failure_mode = "EnvironmentDefault"
description = ""
environment_scope = "FromProjectLifecycles"
multi_tenancy_mode = "Tenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "terraform-plan-additional-resources" {
        name = "Terraform Plan - Destroy"

        action "terraform-plan-destroy" {
            action_type = "Octopus.TerraformPlan"
            properties = {
                Octopus.Action.AzureAccount.Variable = "Project.AzureAccount"
                Octopus.Action.GitRepository.Source = "Project"
                Octopus.Action.GoogleCloud.ImpersonateServiceAccount = "False"
                Octopus.Action.GoogleCloud.UseVMServiceAccount = "True"
                Octopus.Action.Script.ScriptSource = "GitRepository"
                Octopus.Action.Terraform.AdditionalActionParams = "-destroy"
                Octopus.Action.Terraform.AllowPluginDownloads = "True"
                Octopus.Action.Terraform.AzureAccount = "True"
                Octopus.Action.Terraform.EnvVariables = "{\"TF_VAR_argocd_admin_password_hash\":\"#{Project.ArgoCD.AdminPasswordHash}\",\"TF_VAR_datadog_api_key\":\"#{Project.Datadog.ApiKey}\",\"TF_VAR_argocd_insecure\":\"true\",\"TF_VAR_octopus_environments\":\"#{Terraform.Environment.Name}\",\"TF_VAR_octopus_grpc_url\":\"creid.octopus.app:8443\",\"TF_VAR_octopus_space_name\":\"#{Octopus.Space.Name}\",\"TF_VAR_octopus_api_key\":\"#{OctopusApi.ApiKey}\",\"TF_VAR_argocd_admin_password\":\"#{Project.ArgoCD.AdminPassword}\",\"TF_VAR_environment\":\"#{Octopus.Environment.Name | ToLower}\"}"
                Octopus.Action.Terraform.GoogleCloudAccount = "False"
                Octopus.Action.Terraform.ManagedAccount = "None"
                Octopus.Action.Terraform.PlanJsonOutput = "False"
                Octopus.Action.Terraform.RunAutomaticFileSubstitution = "True"
                Octopus.Action.Terraform.TemplateDirectory = "argocd/terraform/"
                OctopusUseBundledTooling = "False"
            }
            worker_pool_variable = "ExecutionContainer.Linux.WorkerPool"

            container {
                feed = "docker-hub"
                image = "#{ExecutionContainer.Linux.DefaultImage}"
            }
        }
    }

    step "approve-additional-resource-terraform-plan" {
        name = "Approve Terraform Destroy Plan"

        action "approve-terraform-destroy-plan" {
            action_type = "Octopus.Manual"
            properties = {
                Octopus.Action.Manual.BlockConcurrentDeployments = "False"
                Octopus.Action.Manual.Instructions = <<-EOT
                    ```
                    #{Octopus.Action[Terraform Plan - Destroy].Output.TerraformPlanOutput}
                    ```
                    EOT
                Octopus.Action.RunOnServer = "false"
            }
        }
    }

    step "terraform-apply-additional-resources" {
        name = "Terraform Apply - Destroy"

        action {
            action_type = "Octopus.TerraformApply"
            properties = {
                Octopus.Action.AzureAccount.Variable = "Project.AzureAccount"
                Octopus.Action.GitRepository.Source = "Project"
                Octopus.Action.GoogleCloud.ImpersonateServiceAccount = "False"
                Octopus.Action.GoogleCloud.UseVMServiceAccount = "True"
                Octopus.Action.Script.ScriptSource = "GitRepository"
                Octopus.Action.Terraform.AdditionalActionParams = "-destroy"
                Octopus.Action.Terraform.AllowPluginDownloads = "True"
                Octopus.Action.Terraform.AzureAccount = "True"
                Octopus.Action.Terraform.EnvVariables = "{\"TF_VAR_argocd_admin_password_hash\":\"#{Project.ArgoCD.AdminPasswordHash}\",\"TF_VAR_datadog_api_key\":\"#{Project.Datadog.ApiKey}\",\"TF_VAR_argocd_insecure\":\"true\",\"TF_VAR_octopus_environments\":\"#{Terraform.Environment.Name}\",\"TF_VAR_octopus_grpc_url\":\"creid.octopus.app:8443\",\"TF_VAR_octopus_space_name\":\"#{Octopus.Space.Name}\",\"TF_VAR_octopus_api_key\":\"#{OctopusApi.ApiKey}\",\"TF_VAR_argocd_admin_password\":\"#{Project.ArgoCD.AdminPassword}\",\"TF_VAR_environment\":\"#{Octopus.Environment.Name | ToLower}\"}"
                Octopus.Action.Terraform.GoogleCloudAccount = "False"
                Octopus.Action.Terraform.ManagedAccount = "None"
                Octopus.Action.Terraform.PlanJsonOutput = "False"
                Octopus.Action.Terraform.RunAutomaticFileSubstitution = "True"
                Octopus.Action.Terraform.TemplateDirectory = "argocd/terraform/"
                OctopusUseBundledTooling = "False"
            }
            worker_pool_variable = "ExecutionContainer.Linux.WorkerPool"

            container {
                feed = "docker-hub"
                image = "#{ExecutionContainer.Linux.DefaultImage}"
            }
        }
    }

    step "patch-argocd-finalizers" {
        name = "Patch ArgoCD Finalizers"
        properties = {
            Octopus.Action.TargetRoles = "k8s-agent"
        }

        action {
            action_type = "Octopus.KubernetesRunScript"
            properties = {
                Octopus.Action.Script.ScriptBody = <<-EOT
                    for app in $(kubectl get applications -n argocd -o jsonpath='{.items[*].metadata.name}'); do kubectl patch application $app -n argocd -p '{"metadata":{"finalizers":null}}' --type=merge
                    ; done
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
            worker_pool_variable = "ExecutionContainer.Linux.WorkerPool"

            container {
                feed = "#{ExecutionContainer.Linux.WorkerPool}Feeds-1001"
                image = "#{ExecutionContainer.Linux.DefaultImage}"
            }
        }
    }
}